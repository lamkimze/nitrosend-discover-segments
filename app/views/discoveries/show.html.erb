<% content_for :title, "Discovery results · Horizon Travel" %>

<div
  data-controller="discover"
  data-discover-fresh-value="<%= @fresh %>"
>
  <div
    data-discover-target="analyzing"
    class="mb-16 max-w-xl <%= 'hidden' unless @fresh %>"
  >
    <p class="brand-mark">Working</p>
    <h1 class="font-display mt-3 text-3xl tracking-tight">Looking through your contacts</h1>
    <p class="meta mt-3 leading-relaxed">
      Destinations, trip style, and recent engagement — grouping people who travel alike.
    </p>
    <ol class="mt-8 space-y-3 text-sm" data-discover-target="steps">
      <li class="analyzing-step is-active" data-step="0">Reading destination and style signals…</li>
      <li class="analyzing-step" data-step="1">Clustering similar travellers…</li>
      <li class="analyzing-step" data-step="2">Writing plain-English reasons…</li>
      <li class="analyzing-step" data-step="3">Suggesting campaign angles…</li>
    </ol>
  </div>

  <div data-discover-target="results" class="<%= @fresh ? 'hidden' : '' %>">
    <section class="mb-10 max-w-2xl">
      <p class="brand-mark">Discovery</p>
      <h1 class="font-display mt-3 text-3xl tracking-tight sm:text-4xl">
        <%= pluralize(@segments.size, "segment") %> worth a look
      </h1>
      <p class="meta mt-4 text-base leading-relaxed">
        Based on <%= @run.contact_count %> Horizon Travel contacts.
        Each proposal includes why it exists — accept what you’ll use, dismiss the rest.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <%= link_to "Back to audiences", root_path, class: "btn-ghost" %>
        <%= button_to "Run again", discoveries_path, method: :post, class: "btn-quiet" %>
      </div>
    </section>

    <% if @insights.any? %>
      <section class="mb-12 panel pt-8" aria-label="Insights">
        <h2 class="font-display text-lg">What stands out</h2>
        <ul class="mt-6 space-y-4">
          <% @insights.each do |insight| %>
            <li class="grid gap-1 sm:grid-cols-[6.5rem_1fr] sm:gap-4">
              <span class="brand-mark pt-0.5"><%= insight_label(insight.kind) %></span>
              <p class="text-sm leading-relaxed sm:text-[0.95rem]"><%= insight.body %></p>
            </li>
          <% end %>
        </ul>
      </section>
    <% end %>

    <section class="panel pt-2">
      <% @segments.each do |segment| %>
        <%= render "segments/row", segment: segment %>
      <% end %>

      <% if @segments.empty? %>
        <p class="meta py-10">No proposed segments in this run. Accepted audiences are unchanged.</p>
      <% end %>
    </section>
  </div>
</div>
