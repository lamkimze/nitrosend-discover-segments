<% content_for :title, "Smart Audiences · Horizon Travel" %>

<section class="mb-12 max-w-2xl">
  <p class="brand-mark">Audience</p>
  <h1 class="font-display mt-3 text-3xl tracking-tight sm:text-4xl">Smart Audiences</h1>
  <p class="meta mt-4 text-base leading-relaxed">
    <%= @contact_count %> contacts. AI organises people from behaviour —
    destinations viewed, campaign engagement, purchases — then you decide what to send.
  </p>

  <div class="mt-8 flex flex-wrap items-center gap-3">
    <%= button_to "Analyse audience", analyse_audience_path, method: :post, class: "btn-primary" %>
    <% if @latest&.completed? %>
      <span class="meta">Last run found <%= @latest.segments_found %> audiences</span>
    <% elsif @latest&.failed? %>
      <span class="meta text-red-900">Last run failed — contacts unchanged</span>
    <% end %>
  </div>
</section>

<% if @latest&.completed? && @latest.summary.present? && @latest.summary["segments"].present? %>
  <section class="mb-10 panel pt-6">
    <p class="brand-mark">Latest refresh</p>
    <p class="meta mt-2">
      +<%= @latest.summary["added_memberships"] %> memberships ·
      −<%= @latest.summary["removed_memberships"] %> memberships moved or removed
    </p>
  </section>
<% end %>

<section class="panel pt-8">
  <h2 class="font-display text-lg">Smart Audiences</h2>

  <% if @segments.any? %>
    <div class="mt-2">
      <% @segments.each do |segment| %>
        <article class="segment-row">
          <div class="flex flex-wrap items-start justify-between gap-4">
            <div class="min-w-0 flex-1">
              <h3 class="font-display text-xl text-[var(--color-ink)]">
                <%= link_to segment.name, segment_path(segment), class: "hover:text-[var(--color-teal-deep)]" %>
              </h3>
              <p class="meta mt-1"><%= pluralize(segment.contact_count, "contact") %></p>
              <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]"><%= segment.description %></p>

              <div class="mt-4 flex flex-wrap items-center gap-4">
                <div>
                  <p class="text-[0.65rem] font-medium uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">AI confidence</p>
                  <p class="mt-1 font-display text-2xl"><%= (segment.confidence_score.to_f * 100).round %>%</p>
                </div>
              </div>

              <% if segment.evidence.present? %>
                <div class="mt-5">
                  <p class="text-[0.65rem] font-medium uppercase tracking-[0.14em] text-[var(--color-ink-faint)]">Why this audience?</p>
                  <ul class="reason-list">
                    <% Array(segment.evidence).each do |line| %>
                      <li><%= line %></li>
                    <% end %>
                  </ul>
                </div>
              <% end %>
            </div>

            <div class="flex flex-col gap-2 sm:items-end">
              <%= link_to "View audience", segment_path(segment), class: "btn-ghost" %>
              <%= link_to "Create campaign", new_segment_campaign_path(segment), class: "btn-primary" %>
            </div>
          </div>
        </article>
      <% end %>
    </div>
  <% else %>
    <p class="font-display mt-6 text-xl text-[var(--color-ink-muted)]">No Smart Audiences yet</p>
    <p class="meta mt-2 max-w-md leading-relaxed">
      Analyse your audience to discover groups from behaviour. Contacts stay untouched until analysis completes successfully.
    </p>
  <% end %>
</section>
