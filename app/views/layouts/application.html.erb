<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "Smart Audiences · Nitrosend" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Nitrosend">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="theme-color" content="#1d4ed8">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <div class="app-shell">
      <header class="site-header">
        <div class="brand-lockup">
          <p class="brand-name">Horizon Travel</p>
          <p class="brand-product">Nitrosend</p>
        </div>
        <nav class="site-nav flex items-center gap-1" aria-label="Primary">
          <%= link_to "Smart Audiences", root_path, class: (request.path == "/" || request.path.start_with?("/segments", "/analyses", "/campaigns", "/audiences")) ? "is-active" : nil %>
        </nav>
      </header>

      <% if flash.any? %>
        <div class="flash-region" role="status">
          <% flash.each do |type, message| %>
            <div class="<%= flash_class(type) %>"><%= message %></div>
          <% end %>
        </div>
      <% end %>

      <main>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
