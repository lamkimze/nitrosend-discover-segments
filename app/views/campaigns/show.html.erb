<% content_for :title, "Campaign · #{@campaign.segment.name}" %>

<nav class="mb-6">
  <%= link_to "← #{@campaign.segment.name}", segment_path(@campaign.segment), class: "btn-quiet px-0" %>
</nav>

<section class="mx-auto max-w-2xl surface px-5 py-7 sm:px-7">
  <p class="eyebrow">Campaign · <%= @campaign.status %></p>
  <h1 class="font-display mt-2 text-3xl tracking-tight"><%= @campaign.subject.presence || "Untitled" %></h1>

  <div class="mt-6 border border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-4">
    <p class="field-label">Audience</p>
    <p class="mt-1.5 font-display text-xl"><%= @campaign.segment.name %></p>
    <p class="meta mt-1"><%= pluralize(@campaign.segment.contact_count, "contact") %></p>
  </div>

  <%= form_with model: @campaign, class: "mt-7 space-y-6" do |f| %>
    <div>
      <%= f.label :subject, class: "field-label" %>
      <%= f.text_field :subject, class: "field-input-underline" %>
    </div>
    <div>
      <%= f.label :content, class: "field-label" %>
      <%= f.text_area :content, rows: 10, class: "field-input text-sm leading-relaxed" %>
    </div>
    <%= f.submit "Save campaign", class: "btn-primary cursor-pointer" %>
  <% end %>

  <p class="meta mt-8 text-xs leading-relaxed">
    Prototype note: sending isn’t wired. The product point is the handoff — audience already selected from a Smart Audience.
  </p>
</section>
