<% content_for :title, "Create campaign · #{@segment.name}" %>

<nav class="mb-6">
  <%= link_to "← #{@segment.name}", segment_path(@segment), class: "btn-quiet px-0" %>
</nav>

<section class="mx-auto max-w-2xl surface px-5 py-7 sm:px-7">
  <p class="eyebrow">Campaign</p>
  <h1 class="font-display mt-2 text-3xl tracking-tight">New campaign</h1>

  <div class="mt-6 border border-[var(--color-line)] bg-[var(--color-surface)] px-4 py-4">
    <p class="field-label">Audience</p>
    <p class="mt-1.5 font-display text-xl"><%= @segment.name %></p>
    <p class="meta mt-1"><%= pluralize(@segment.contact_count, "contact") %> · already selected</p>
    <% angle = @segment.campaign_angle %>
    <p class="meta mt-3 text-xs leading-relaxed">Angle: <%= angle[:why] %></p>
  </div>

  <%= form_with model: [@segment, @campaign], class: "mt-7 space-y-6" do |f| %>
    <div>
      <%= f.label :subject, "Subject", class: "field-label" %>
      <%= f.text_field :subject, class: "field-input-underline" %>
    </div>
    <div>
      <%= f.label :content, "Content", class: "field-label" %>
      <%= f.text_area :content, rows: 10, class: "field-input text-sm leading-relaxed" %>
    </div>
    <div class="flex flex-wrap gap-2">
      <%= f.submit "Save campaign", class: "btn-primary cursor-pointer" %>
      <%= link_to "Cancel", segment_path(@segment), class: "btn-ghost" %>
    </div>
  <% end %>
</section>
