<% content_for :title, "#{@segment.name} · Smart Audiences" %>

<nav class="mb-8">
  <%= link_to "← Smart Audiences", root_path, class: "btn-quiet px-0" %>
</nav>

<div class="grid gap-12 lg:grid-cols-[1.15fr_0.85fr]">
  <div>
    <p class="brand-mark">Smart Audience · <%= @segment.source %></p>
    <h1 class="font-display mt-3 text-3xl tracking-tight sm:text-4xl"><%= @segment.name %></h1>
    <p class="meta mt-3">
      <%= pluralize(@segment.contact_count, "contact") %> ·
      <%= (@segment.confidence_score.to_f * 100).round %>% confidence
    </p>
    <p class="mt-5 text-[0.95rem] leading-relaxed text-[var(--color-ink-muted)]"><%= @segment.description %></p>

    <section class="mt-10">
      <h2 class="font-display text-lg">Why we created this audience</h2>
      <ul class="reason-list mt-4 text-[0.95rem]">
        <% Array(@segment.evidence).each do |line| %>
          <li><%= line %></li>
        <% end %>
      </ul>
    </section>

    <section class="mt-10 border-l-2 border-[var(--color-teal)] pl-4">
      <h2 class="font-display text-lg">Suggested campaign angle</h2>
      <p class="mt-3 text-sm font-medium leading-snug text-[var(--color-ink)]"><%= @angle[:subject] %></p>
      <p class="meta mt-2 text-sm leading-relaxed"><%= @angle[:why] %></p>
    </section>

    <div class="mt-10 flex flex-wrap items-center gap-3">
      <%= link_to "Create campaign", new_segment_campaign_path(@segment), class: "btn-primary" %>
      <%= button_to "Dismiss audience", archive_segment_path(@segment), method: :post, class: "btn-ghost", form: { data: { turbo_confirm: "Dismiss this audience? Contacts stay as they are." } } %>
    </div>

    <section class="mt-12 panel pt-8">
      <h2 class="font-display text-lg">Contacts</h2>
      <ul class="mt-6 divide-y divide-[var(--color-line)]">
        <% @memberships.limit(40).each do |membership| %>
          <li class="flex items-start gap-3 py-3">
            <span class="avatar"><%= membership.contact.initials %></span>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-medium"><%= membership.contact.full_name %></p>
              <p class="meta truncate text-xs"><%= membership.contact.email %></p>
              <% if membership.reason.present? %>
                <p class="mt-1 text-xs leading-relaxed text-[var(--color-ink-muted)]"><%= membership.reason %></p>
              <% end %>
            </div>
            <span class="meta shrink-0 text-xs"><%= (membership.score.to_f * 100).round %>%</span>
          </li>
        <% end %>
      </ul>
      <% if @memberships.size > 40 %>
        <p class="meta mt-3">Showing 40 of <%= @memberships.size %></p>
      <% end %>
    </section>
  </div>

  <aside class="lg:border-l lg:border-[var(--color-line)] lg:pl-10">
    <p class="brand-mark">Boundary</p>
    <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink)]">
      AI controls how this audience is organised. You still control whether — and what — to send.
    </p>
    <p class="meta mt-6 text-xs leading-relaxed">
      Dismiss removes the proposal from this list. Membership scores and reasons stay inspectable until you dismiss — so an agent (or teammate) can challenge the grouping before anything goes out.
    </p>
  </aside>
</div>
