<%= link_to segment_path(segment), class: "segment-row group" do %>
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div class="min-w-0 flex-1">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-display text-lg text-[var(--color-ink)] group-hover:text-[var(--color-teal-deep)]">
          <%= segment.name %>
        </h3>
        <% if local_assigns[:badge] %>
          <span class="rounded-sm bg-[var(--color-paper-2)] px-1.5 py-0.5 text-[0.65rem] font-medium uppercase tracking-wider text-[var(--color-ink-muted)]">
            <%= badge %>
          </span>
        <% end %>
      </div>
      <div class="meta mt-1 flex flex-wrap items-center gap-x-3 gap-y-1">
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block h-1.5 w-1.5 rounded-full <%= strength_dot_class(segment.strength) %>"></span>
          <%= segment.strength.capitalize %> signal
        </span>
        <span><%= pluralize(segment.contact_count, "contact") %></span>
      </div>
      <% if segment.reasons.present? %>
        <ul class="reason-list">
          <% Array(segment.reasons).first(2).each do |reason| %>
            <li><%= reason %></li>
          <% end %>
        </ul>
      <% end %>
    </div>
    <span class="meta shrink-0 pt-1 opacity-0 transition group-hover:opacity-100">View →</span>
  </div>

  <% samples = segment.sample_contacts(4) %>
  <% if samples.any? %>
    <div class="mt-4 flex items-center gap-2">
      <div class="flex -space-x-1.5">
        <% samples.each do |contact| %>
          <span class="avatar ring-2 ring-[var(--color-paper)]" title="<%= contact.name %>"><%= contact.initials %></span>
        <% end %>
      </div>
      <span class="meta text-xs">
        <%= samples.map(&:name).first(2).join(", ") %>
        <% if segment.contact_count > 2 %>
          +<%= segment.contact_count - [2, samples.size].min %>
        <% end %>
      </span>
    </div>
  <% end %>
<% end %>
